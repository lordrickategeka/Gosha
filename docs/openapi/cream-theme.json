{
  "openapi": "3.0.3",
  "info": {
    "title": "Cream Theme partner API",
    "version": "1.0.0",
    "description": "Backend-to-backend hosted payments and transactional mail used by GarageHQ. Both partner headers are required together. Partners use one centrally managed Flutterwave account and do not receive Flutterwave keys. Configure test/live mode in the Cream Theme partner account; every payment retains its original environment. This reference describes the partner payment/mail contracts, not all Cream Theme products. Never trust browser redirect claims as payment proof.\n\nBefore connecting, configure trusted HTTPS certificates in both web PHP and CLI workers. cURL error 60 can indicate missing/outdated CA trust or a server certificate-chain problem; Apache and CLI may load different php.ini files. Keep TLS verification enabled. See /user-guide#api-reference-for-integration-partners."
  },
  "servers": [
    {
      "url": "https://comhub.loganate.cc",
      "description": "Cream Theme service; use the operator-confirmed root URL for your environment"
    }
  ],
  "security": [
    {
      "partnerKey": [],
      "partnerSecret": []
    }
  ],
  "paths": {
    "/api/partner-keys/payments/initiate": {
      "post": {
        "summary": "Start hosted checkout",
        "operationId": "initiatePartnerPayment",
        "tags": [
          "Hosted payments"
        ],
        "description": "Use a stable reference for idempotency. A retry while pending reuses the transaction with its original amount/fields. A resolved reference returns the final record. Redirect the user to checkoutUrl; verify the returned txRef before granting access. Amount must be positive; a zero-cost trial does not need this endpoint.",
        "responses": {
          "201": {
            "description": "Payment record and checkout URL when pending.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Payment"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request; inspect the stable error code.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PartnerError"
                }
              }
            }
          },
          "401": {
            "description": "Missing/invalid partner credentials.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PartnerError"
                }
              }
            }
          },
          "403": {
            "description": "Inactive or expired partner.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PartnerError"
                }
              }
            }
          },
          "404": {
            "description": "Requested partner record/template was not found.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PartnerError"
                }
              }
            }
          },
          "429": {
            "description": "Partner quota reached.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PartnerError"
                }
              }
            }
          },
          "500": {
            "description": "Internal or mail-provider error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PartnerError"
                }
              }
            }
          },
          "503": {
            "description": "Payment or mail provider is not configured.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PartnerError"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "amount": {
                    "type": "number",
                    "exclusiveMinimum": true,
                    "minimum": 0
                  },
                  "currency": {
                    "type": "string",
                    "pattern": "^[A-Za-z]{3}$"
                  },
                  "customerEmail": {
                    "type": "string",
                    "format": "email"
                  },
                  "customerName": {
                    "type": "string"
                  },
                  "redirectUrl": {
                    "type": "string",
                    "format": "uri"
                  },
                  "narration": {
                    "type": "string"
                  },
                  "reference": {
                    "type": "string"
                  },
                  "meta": {
                    "type": "object",
                    "additionalProperties": true
                  }
                },
                "required": [
                  "amount",
                  "currency",
                  "customerEmail",
                  "redirectUrl"
                ]
              },
              "example": {
                "amount": 30000,
                "currency": "UGX",
                "customerEmail": "buyer@example.com",
                "customerName": "Example buyer",
                "redirectUrl": "https://partner.example.com/payments/return",
                "reference": "invoice-example-001",
                "meta": {
                  "invoiceId": "example-001"
                }
              }
            }
          }
        }
      }
    },
