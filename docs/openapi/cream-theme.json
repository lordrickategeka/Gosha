                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "txRef",
            "in": "path",
            "required": true,
            "description": "The txRef returned by initiation, not the optional partner reference.",
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    },
