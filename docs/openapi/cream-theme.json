    "/api/mail/send": {
      "post": {
        "summary": "Send a transactional email",
        "operationId": "sendPartnerMail",
        "tags": [
          "Transactional mail"
        ],
        "description": "Every send attempt is logged and counts toward quota. No mail idempotency key is documented; an ambiguous timeout may require operator checking before resending. Template placeholders use {{variableName}}; omitted values render empty.",
        "responses": {
          "201": {
            "description": "Provider accepted the email; this is not an inbox-delivery guarantee.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MailResult"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request; inspect the stable error code.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PartnerError"
                }
              }
            }
          },
          "401": {
            "description": "Missing/invalid partner credentials.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PartnerError"
                }
              }
            }
          },
          "403": {
            "description": "Inactive or expired partner.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PartnerError"
                }
              }
            }
          },
          "404": {
            "description": "Requested partner record/template was not found.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PartnerError"
                }
              }
            }
          },
          "429": {
            "description": "Partner quota reached.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PartnerError"
                }
              }
            }
          },
          "500": {
            "description": "Internal or mail-provider error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PartnerError"
                }
              }
            }
          },
          "503": {
            "description": "Payment or mail provider is not configured.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PartnerError"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "to": {
                    "oneOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      }
                    ]
                  },
                  "from": {
                    "type": "string",
                    "description": "Optional verified sender; defaults to configured sender."
                  },
                  "cc": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "bcc": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "replyTo": {
                    "type": "string"
                  },
                  "subject": {
                    "type": "string"
                  },
                  "html": {
                    "type": "string"
                  },
                  "text": {
                    "type": "string"
                  }
                },
                "required": [
                  "to",
                  "subject",
                  "html"
                ]
              }
            }
          }
        }
      }
    },
