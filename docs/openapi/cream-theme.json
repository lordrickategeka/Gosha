  "components": {
    "securitySchemes": {
      "partnerKey": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Api-Key"
      },
      "partnerSecret": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Api-Secret"
      }
    },
    "schemas": {
      "PartnerError": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string",
            "description": "Stable error code, e.g. invalid_api_credentials, partnership_expired, payment_quota_exceeded, daily_send_quota_exceeded, mail_not_configured."
          },
          "messageId": {
            "type": "integer",
            "description": "May be returned for a logged failed mail send."
          }
        },
        "required": [
          "error"
        ]
      },
      "Payment": {
        "type": "object",
        "properties": {
          "paymentId": {
            "type": "integer"
          },
          "txRef": {
            "type": "string"
          },
          "reference": {
            "type": "string",
            "nullable": true
          },
          "amount": {
            "type": "number"
          },
          "currency": {
            "type": "string",
            "minLength": 3,
            "maxLength": 3
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "successful",
              "failed",
              "cancelled"
            ]
          },
          "environment": {
            "type": "string",
            "enum": [
              "test",
              "live"
            ]
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "confirmedAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
