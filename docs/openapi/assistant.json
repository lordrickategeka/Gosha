{
  "openapi": "3.0.3",
  "info": {
    "title": "Shared System Assistant API",
    "version": "1.0.0",
    "description": "Backend contract for the shared Salord System Assistant. The calling product authenticates its users and supplies approved documentation for each request. This is document retrieval, not model fine-tuning or access to operational databases. Matching excerpts and the question are sent to the configured AI provider. Use a dedicated system-specific bearer key on the backend only. A configured tenant mapping selects the active tenant and its model settings.\n\nBefore connecting, configure trusted HTTPS certificates in both web PHP and CLI workers. cURL error 60 can indicate missing/outdated CA trust or a server certificate-chain problem; Apache and CLI may load different php.ini files. Keep TLS verification enabled. See /user-guide#api-reference-for-integration-partners."
  },
  "servers": [
    {
      "url": "https://cot.loganate.cc"
    }
  ],
  "security": [
    {
      "systemBearer": []
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "summary": "Check service liveness",
        "operationId": "getAssistantHealth",
        "tags": [
          "Health"
        ],
        "description": "",
        "responses": {
          "200": {
            "description": "Service running; does not validate keys or model readiness.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        },
        "security": []
      }
    },
    "/v1/chat": {
      "post": {
        "summary": "Explain approved product documentation",
        "operationId": "askSharedSystemAssistant",
        "tags": [
          "Chat"
        ],
        "description": "Question limit: 1,200 characters. Documentation limit: 220,000 UTF-8 bytes of JSON. Retrieves up to five matching guides with valid local paths and returns up to eight links. Actor is a product-local pseudonymous user identifier. No chat history, operational actions, live records or browser tools are supported. Do not retry timeouts automatically: the model may already have processed the request.",
        "responses": {
          "200": {
            "description": "Answer and sources. No matching guides also returns 200, without a model call.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "answer": {
                      "type": "string",
                      "maxLength": 6000
                    },
                    "sources": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "title": {
                            "type": "string"
                          },
                          "path": {
                            "type": "string"
                          }
                        }
                      }
                    }
                  },
                  "required": [
                    "answer",
                    "sources"
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Invalid question, actor, JSON or docs.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AssistantError"
                }
              }
            }
          },
          "401": {
            "description": "System/key pair rejected.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AssistantError"
                }
              }
            }
          },
          "413": {
            "description": "Request body exceeds two MiB.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AssistantError"
                }
              }
            }
          },
          "429": {
            "description": "Actor rate limit reached.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AssistantError"
                }
              }
            }
          },
          "500": {
            "description": "Internal error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AssistantError"
                }
              }
            }
          },
          "502": {
            "description": "Model unavailable or returned invalid output.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AssistantError"
                }
              }
            }
          },
          "503": {
            "description": "Mapped tenant or model is not configured/active.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AssistantError"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "system": {
                    "type": "string",
                    "pattern": "^[a-z0-9][a-z0-9-]{1,63}$",
                    "example": "garagehq"
                  },
                  "actor": {
                    "type": "string",
                    "pattern": "^[a-zA-Z0-9:_-]+$",
                    "maxLength": 80
                  },
                  "role": {
                    "type": "string",
                    "maxLength": 40
                  },
                  "question": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 1200
                  },
                  "docs": {
                    "type": "object",
                    "properties": {
                      "overview": {
                        "type": "object",
                        "properties": {
                          "intro": {
                            "type": "string"
                          }
                        }
                      },
                      "supportGuides": {
                        "type": "array",
                        "items": {
                          "$ref": "#/components/schemas/Guide"
                        }
                      },
                      "moduleGuides": {
                        "type": "array",
                        "items": {
                          "$ref": "#/components/schemas/Guide"
                        }
                      }
                    }
                  }
                },
                "required": [
                  "system",
                  "actor",
                  "question",
                  "docs"
                ]
              }
            }
          }
        }
      }
    },
    "/api/admin/providers": {
      "get": {
        "summary": "List selectable AI providers",
        "operationId": "listAssistantProviders",
        "tags": [
          "Provider administration"
        ],
        "description": "A configured flag does not prove inference readiness or account balance. Self-hosted localhost refers to the machine running Cot. Model keys may be saved using the separate credential endpoints. Server environment keys remain defaults; model-server URLs are operator-managed. No keys or ciphertext are returned.",
        "responses": {
          "200": {
            "description": "Provider labels, descriptions, default model suggestions and configuration flags. Contains no keys or server addresses.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "providers": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "string",
                            "enum": [
                              "ollama_cloud",
                              "groq",
                              "ollama_local"
                            ]
                          },
                          "label": {
                            "type": "string"
                          },
                          "description": {
                            "type": "string"
                          },
                          "defaultModel": {
                            "type": "string"
                          },
                          "configured": {
                            "type": "boolean"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Sign in required.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AssistantError"
                }
              }
            }
          },
          "403": {
            "description": "Platform administrator required, or write origin rejected.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AssistantError"
                }
              }
            }
          }
        },
        "security": [
          {
            "adminSession": []
          }
        ],
        "parameters": [
          {
            "name": "X-Tenant-Slug",
            "in": "header",
            "required": false,
            "description": "Active tenant slug; defaults to default. The same administrator session can configure authorized tenants.",
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    },
    "/api/admin/models": {
      "get": {
        "summary": "List models from a provider",
        "operationId": "listAssistantProviderModels",
        "tags": [
          "Provider administration"
        ],
        "description": "Omitting provider selects the current tenant's saved provider. Groq identifiers can contain a namespace slash. Known cloud aliases are excluded from the self-hosted list. Model listing does not establish available credits or inference readiness.",
        "responses": {
          "200": {
            "description": "Available model identifiers.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "models": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Sign in required.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AssistantError"
                }
              }
            }
          },
          "403": {
            "description": "Platform administrator required, or write origin rejected.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AssistantError"
                }
              }
            }
          },
          "400": {
            "description": "Unknown provider.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AssistantError"
                }
              }
            }
          },
          "502": {
            "description": "Provider catalog unavailable or invalid.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AssistantError"
                }
              }
            }
          },
          "503": {
            "description": "Provider not configured.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AssistantError"
                }
              }
            }
          }
        },
        "security": [
          {
            "adminSession": []
          }
        ],
        "parameters": [
          {
            "name": "X-Tenant-Slug",
            "in": "header",
            "required": false,
            "description": "Active tenant slug; defaults to default. The same administrator session can configure authorized tenants.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "provider",
            "in": "query",
            "required": false,
            "description": "",
            "schema": {
              "type": "string",
              "enum": [
                "ollama_cloud",
                "groq",
                "ollama_local"
              ]
            }
          }
        ]
      }
    },
    "/api/admin/model-test": {
      "post": {
        "summary": "Test an unsaved provider and model",
        "operationId": "testAssistantModel",
        "tags": [
          "Provider administration"
        ],
        "description": "Sends one fixed short prompt to the selected provider. May consume quota or incur charges under the operator's provider plan. Does not save settings or silently switch providers. Provider response bodies and credentials are not returned.",
        "responses": {
          "200": {
            "description": "A short completion succeeded; no tenant settings were changed.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Sign in required.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AssistantError"
                }
              }
            }
          },
          "403": {
            "description": "Platform administrator required, or write origin rejected.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AssistantError"
                }
              }
            }
          },
          "400": {
            "description": "Invalid provider or model.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AssistantError"
                }
              }
            }
          },
          "429": {
            "description": "Administrative test limit or provider token/request limit reached.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AssistantError"
                }
              }
            }
          },
          "502": {
            "description": "Inference failed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AssistantError"
                }
              }
            }
          },
          "503": {
            "description": "Provider configuration, access or billing/credit failure.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AssistantError"
                }
              }
            }
          }
        },
        "security": [
          {
            "adminSession": []
          }
        ],
        "parameters": [
          {
            "name": "X-Tenant-Slug",
            "in": "header",
            "required": false,
            "description": "Active tenant slug; defaults to default. The same administrator session can configure authorized tenants.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "Origin",
            "in": "header",
            "required": true,
            "description": "Same origin as Cot, required for writes, e.g. https://cot.loganate.cc.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "provider": {
                    "type": "string",
                    "enum": [
                      "ollama_cloud",
                      "groq",
                      "ollama_local"
                    ]
                  },
                  "model": {
                    "type": "string",
                    "maxLength": 150
                  }
                },
                "required": [
                  "provider",
                  "model"
                ]
              }
            }
          }
        }
      }
    },
    "/api/admin/settings": {
      "get": {
        "summary": "Read tenant assistant settings",
        "operationId": "getAssistantTenantSettings",
        "tags": [
          "Provider administration"
        ],
        "description": "",
        "responses": {
          "200": {
            "description": "Current branding, provider/model and other tenant settings.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "settings": {
                      "type": "object",
                      "properties": {
                        "provider": {
                          "type": "string",
                          "enum": [
                            "ollama_cloud",
                            "groq",
                            "ollama_local"
                          ]
                        },
                        "model": {
                          "type": "string"
                        }
                      },
                      "additionalProperties": true
                    },
                    "tenant": {
                      "type": "object"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Sign in required.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AssistantError"
                }
              }
            }
          },
          "403": {
            "description": "Platform administrator required, or write origin rejected.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AssistantError"
                }
              }
            }
          }
        },
        "security": [
          {
            "adminSession": []
          }
        ],
        "parameters": [
          {
            "name": "X-Tenant-Slug",
            "in": "header",
            "required": false,
            "description": "Active tenant slug; defaults to default. The same administrator session can configure authorized tenants.",
            "schema": {
              "type": "string"
            }
          }
        ]
      },
      "post": {
        "summary": "Save tenant provider/model selection",
        "operationId": "saveAssistantTenantSettings",
        "tags": [
          "Provider administration"
        ],
        "description": "Accepts partial updates of recognized tenant settings. Selection applies to that tenant's chat, streaming answers, code explanations and mapped partner systems. Other tenants are unaffected. Existing tenants retain their saved model and default to Ollama Cloud. Provider keys and URLs cannot be saved here. There is no automatic paid-provider fallback.",
        "responses": {
          "200": {
            "description": "Updated tenant settings.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "settings": {
                      "type": "object"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Sign in required.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AssistantError"
                }
              }
            }
          },
          "403": {
            "description": "Platform administrator required, or write origin rejected.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AssistantError"
                }
              }
            }
          },
          "400": {
            "description": "Invalid settings, unsupported fields or selected provider not configured.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AssistantError"
                }
              }
            }
          }
        },
        "security": [
          {
            "adminSession": []
          }
        ],
        "parameters": [
          {
            "name": "X-Tenant-Slug",
            "in": "header",
            "required": false,
            "description": "Active tenant slug; defaults to default. The same administrator session can configure authorized tenants.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "Origin",
            "in": "header",
            "required": true,
            "description": "Same origin as Cot, required for writes, e.g. https://cot.loganate.cc.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "provider": {
                    "type": "string",
                    "enum": [
                      "ollama_cloud",
                      "groq",
                      "ollama_local"
                    ]
                  },
                  "model": {
                    "type": "string",
                    "maxLength": 150
                  }
                },
                "additionalProperties": true
              },
              "example": {
                "provider": "groq",
                "model": "openai/gpt-oss-120b"
              }
            }
          }
        }
      }
    },
    "/api/admin/provider-credentials": {
      "get": {
        "summary": "Read masked key status for a tenant/provider",
        "operationId": "getAssistantCredentialStatus",
        "tags": [
          "Provider credentials"
        ],
        "description": "",
        "responses": {
          "200": {
            "description": "Status only; no plaintext key or ciphertext.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "credential": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "string",
                          "enum": [
                            "ollama_cloud",
                            "groq",
                            "ollama_local"
                          ]
                        },
                        "configured": {
                          "type": "boolean"
                        },
                        "hasSavedKey": {
                          "type": "boolean"
                        },
                        "hasApiKey": {
                          "type": "boolean"
                        },
                        "credentialSource": {
                          "type": "string",
                          "enum": [
                            "saved",
                            "environment",
                            "none"
                          ]
                        },
                        "locked": {
                          "type": "boolean"
                        }
                      },
                      "additionalProperties": true
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Sign in required.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AssistantError"
                }
              }
            }
          },
          "403": {
            "description": "Platform administrator required, or write origin rejected.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AssistantError"
                }
              }
            }
          },
          "400": {
            "description": "Invalid provider, key or unsupported field.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AssistantError"
                }
              }
            }
          }
        },
        "security": [
          {
            "adminSession": []
          }
        ],
        "parameters": [
          {
            "name": "X-Tenant-Slug",
            "in": "header",
            "required": false,
            "description": "Active tenant slug; defaults to default. The same administrator session can configure authorized tenants.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "provider",
            "in": "query",
            "required": true,
            "description": "",
            "schema": {
              "type": "string",
              "enum": [
                "ollama_cloud",
                "groq",
                "ollama_local"
              ]
            }
          }
        ]
      },
      "post": {
        "summary": "Save or replace an encrypted tenant provider key",
        "operationId": "saveAssistantProviderKey",
        "tags": [
          "Provider credentials"
        ],
        "description": "Dedicated model-provider credential endpoint, separate from branding/model settings and system integration bearer keys. AES-256-GCM encrypts the key at rest and binds it to the tenant/provider. The encryption key is kept in a private file beside the database. Saved UI keys take precedence over environment defaults for this tenant only and apply immediately to requests using that provider. Responses never echo the key. Back up the database and its .credentials.key file together.",
        "responses": {
          "200": {
            "description": "Key saved. Response contains only status and a safe message.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "credential": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "string",
                          "enum": [
                            "ollama_cloud",
                            "groq",
                            "ollama_local"
                          ]
                        },
                        "configured": {
                          "type": "boolean"
                        },
                        "hasSavedKey": {
                          "type": "boolean"
                        },
                        "hasApiKey": {
                          "type": "boolean"
                        },
                        "credentialSource": {
                          "type": "string",
                          "enum": [
                            "saved",
                            "environment",
                            "none"
                          ]
                        },
                        "locked": {
                          "type": "boolean"
                        }
                      },
                      "additionalProperties": true
                    },
                    "message": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Sign in required.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AssistantError"
                }
              }
            }
          },
          "403": {
            "description": "Platform administrator required, or write origin rejected.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AssistantError"
                }
              }
            }
          },
          "400": {
            "description": "Invalid provider, key or unsupported field.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AssistantError"
                }
              }
            }
          },
          "429": {
            "description": "Credential operation rate limit reached.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AssistantError"
                }
              }
            }
          },
          "503": {
            "description": "Encrypted credential cannot be unlocked; restore the matching encryption key/database backup.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AssistantError"
                }
              }
            }
          }
        },
        "security": [
          {
            "adminSession": []
          }
        ],
        "parameters": [
          {
            "name": "X-Tenant-Slug",
            "in": "header",
            "required": false,
            "description": "Active tenant slug; defaults to default. The same administrator session can configure authorized tenants.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "Origin",
            "in": "header",
            "required": true,
            "description": "Same origin as Cot, required for writes, e.g. https://cot.loganate.cc.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "provider": {
                    "type": "string",
                    "enum": [
                      "ollama_cloud",
                      "groq",
                      "ollama_local"
                    ]
                  },
                  "apiKey": {
                    "type": "string",
                    "minLength": 8,
                    "maxLength": 4096,
                    "writeOnly": true,
                    "description": "New key; printable ASCII, without spaces or line breaks. Stored keys are never returned. Omit/blank is rejected, not a request to clear the key."
